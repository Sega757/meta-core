FROM golang:1.22-alpine AS builder

WORKDIR /app
RUN echo 'package main; import "net/http"; func main() { http.HandleFunc("/health", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(200); w.Write([]byte("OK")) }); http.ListenAndServe(":8080", nil) }' > main.go
RUN go build -o go-metacore main.go

FROM alpine:latest
RUN apk add --no-cache curl sqlite
WORKDIR /app
COPY --from=builder /app/go-metacore /app/go-metacore

EXPOSE 8080 50051
CMD ["/app/go-metacore"]
